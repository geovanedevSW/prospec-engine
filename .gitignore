# Production build outputs
dist/
**/dist/
build/
**/build/
.output/

# Environment files & secrets (CRITICAL: prevents leaking API keys)
.env
.env*.local
*.env
**/.env
**/.env.*
!**/.env.example

# Local SQLite databases & temporary DB files
*.sqlite
*.sqlite-*
*.db
*.db-*
*.sqlite3
prospec-app/data/operacao.sqlite
prospec-app/data/*.sqlite
prospec-app/data/*.db
prospec/data/operacao.sqlite
prospec/data/*.sqlite
prospec/data/*.db
operacao-local/data/operacao.sqlite
operacao-local/data/*.sqlite
operacao-local/data/*.db
doop/data/pg/

# Scratch and temporary testing artifacts
scratch/
**/scratch/
test-results/
**/test-results/
screenshots-test/
**/screenshots-test/
screenshots/
temp/
tmp/
*.tmp

# Test coverage & Playwright reports
playwright-report/
**/playwright-report/
blob-report/
coverage/
.nyc_output/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS & Editor generated files
.DS_Store
Thumbs.db
ehthumbs.db
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Sibling sub-repositories (each maintains its own Git repository & history)
/google-maps-scraper-kit/
/OpenWA/
/doop/

# Claude CLI local junctions & caches (source of truth is tracked in .agents/)
.claude/
