# Prospec - Plataforma de Prospecção Ativa - Variáveis de Ambiente
# Copie este arquivo para .env se desejar customizar as portas ou modos.

# Porta da Central Prospec (onde o painel e a API são servidos)
PORT=3333

# Modo de Operação:
# - 'mock': 100% simulado, isolado
# - 'integrado_sem_envio': dados reais lidos, disparos reais bloqueados com segurança (PADRÃO)
# - 'real': permite envios e chamadas reais
OPERATION_MODE=integrado_sem_envio

# Portas dos Serviços Integrados
SCRAPER_PORT=8080
OPENWA_PORT=2785
DOOP_PORT=4400
DOOP_CLIENT_PORT=4300

# Provedores de IA - Claude Sonnet 5 via GhostCLI (Anthropic Messages API)
LLM_PROVIDER=anthropic
LLM_BASE_URL=https://ghostcli.cloud
LLM_API_KEY=gcli_sua_chave_aqui
LLM_MODEL=claude-sonnet-5
LLM_SUPPORTS_VISION=true

